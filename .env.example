# Reference for the variables Warden reads from the environment, with their defaults. Export the ones
# you need before starting the server (the server reads the environment, not this file). You can keep
# real values in a local .env if you like, since it is gitignored. Never commit a real key.

# Run mode: "replay" needs no key and always works (use this for a live demo).
# "live" drives a real Claude model and needs a key.
WARDEN_MODE=replay

# Only needed for WARDEN_MODE=live.
ANTHROPIC_API_KEY=

# Model used in live mode.
WARDEN_MODEL=claude-haiku-5-5

# Seconds a high-risk action waits for a human decision before it is auto-denied.
WARDEN_APPROVAL_TIMEOUT_SECONDS=120

# Pause between agent steps in replay mode, so the stream is easy to follow. Set 0 for no pause.
WARDEN_STEP_DELAY_SECONDS=0.6

# Host and port for the control-plane API.
WARDEN_HOST=127.0.0.1
WARDEN_PORT=8800

# Optional real GitHub connector for the repository tool. Leave the token blank to keep the synthetic
# tool, which is what the default demo and the whole test suite use. See docs/github-setup.md before
# turning this on, and only ever point it at a throwaway org with throwaway test accounts.
# A fine-grained token with repository Administration: read and write on ONLY the throwaway repos.
WARDEN_GITHUB_TOKEN=
# The throwaway organization the agent is allowed to act in. The agent can never act outside it.
WARDEN_GITHUB_ORG=
# Comma-separated repos in that org the agent may touch. Anything else is refused.
WARDEN_GITHUB_REPOS=payments-api
# Comma-separated logins the agent is allowed to remove. A login not listed here is always refused,
# so a real collaborator can never be removed even if the agent proposes it.
WARDEN_GITHUB_TEST_LOGINS=
# Writes are a dry run until this is true. Keep it false to rehearse safely; set true for the real run.
WARDEN_GITHUB_ALLOW_WRITES=false
